{
  "name": "bullgram-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Управление подписками Bullgram (Backend)",
  "scripts": {
    "deploy": "DEPLOY_HOST=${DEPLOY_HOST:?required} rsync -avz --delete --exclude='node_modules' --exclude='.git' --exclude='_site' --exclude='.env' --exclude='.env.backup-*' --exclude='logs' --exclude='uploads' ./ \"${DEPLOY_USER:-root}@${DEPLOY_HOST}\":/var/www/backend/",
    "pull": "DEPLOY_HOST=${DEPLOY_HOST:?required} rsync -avz --delete --exclude='node_modules' --exclude='.git' --exclude='_site' --exclude='.env' --exclude='.env.backup-*' --exclude='logs' --exclude='uploads' \"${DEPLOY_USER:-root}@${DEPLOY_HOST}\":/var/www/backend/ ./",
    "test:autopost": "node test/autopost-timezone.test.js && node test/autopost-tz-bounds.test.js && node test/autopost-queue.test.js && node test/autopost-tier.test.js && node test/autopost-reactions.test.js && node test/autopost-bestof.test.js && node test/autopost-checklists.test.js && node test/autopost-checklist-ops.test.js && node test/userbot-ops.test.js && node test/ops-center-selection.test.js",
    "test:sales": "node test/contour-admin-rights.test.js && node test/shop-quarantine.test.js && node --test test/listed-health-auto-restore.test.js",
    "test:shop-delivery": "node test/shop-delivery.test.js",
    "test:intake": "node test/account-intake.test.js",
    "test:qr-auth": "node test/qr-auth.test.js",
    "test:sale-scan": "node test/sale-scan.test.js",
    "test:messaging": "node test/messaging-router.test.js",
    "test:broadcast": "node test/broadcast-router.test.js",
    "test:broadcast-cleanup": "node test/broadcast-cleanup.test.js",
    "test:lifecycle": "node test/lifecycle-dm.test.js",
    "test:mcp": "node test/mcp-shared.test.js && node test/mcp-dispatch.test.js && node test/external-rest.test.js && node test/mcp-userbot-list.test.js",
    "test:logging": "node test/logger.test.js",
    "test:jobs": "node test/job-runner.test.js",
    "test:client-log": "node test/client-log.test.js",
    "test:contours": "node test/contours-overview.test.js",
    "test:entity": "node test/userbot-entity-resolution.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.3",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.2.4",
    "adm-zip": "^0.6.1",
    "async-mutex": "^0.5.0",
    "axios": "^1.13.6",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "resend": "^6.37.0",
    "socks-proxy-agent": "^9.0.0",
    "sqlite3": "^6.0.1",
    "telegraf": "^4.16.3",
    "teleproto": "^1.232.1",
    "ws": "^8.21.0"
  }
}
